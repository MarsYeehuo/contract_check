# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实 Key。
# 系统环境变量优先于 .env。
# 可选路径覆盖。默认已适配本地开发与 Docker，需要时再取消注释。
# DATA_DIR=./data
# RULES_PATH=./rules/review_rules.yaml
# SAMPLES_DIR=./samples
# 合同文本上限
MAX_TEXT_CHARS=200000

# LLM 兜底（可选）。不填 Key 时前端会进入明确的模拟模式。
LLM_ENABLED=true
# API Key 与 Auth Token 二选一，同时存在时优先使用 API Key。
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# 兼容 Anthropic 协议的服务端可覆盖 Base URL，留空使用官方端点。
# 使用兼容端点时，模型名按该服务商文档填写（例如 deepseek-flash）。
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CONTRACT_CHARS=50000

# 开发环境跨域来源
CORS_ORIGINS=http://localhost:5173
